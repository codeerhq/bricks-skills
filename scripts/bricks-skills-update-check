#!/usr/bin/env sh
# Check whether a newer Bricks skills pack is available.

set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="${BRICKS_SKILLS_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
STATE_DIR="${BRICKS_SKILLS_STATE_DIR:-$HOME/.bricks-skills}"
CACHE_FILE="$STATE_DIR/last-update-check"
MARKER_FILE="$STATE_DIR/just-updated-from"
VERSION_FILE="$ROOT/VERSION"
SEMVER_COMPARE="$SCRIPT_DIR/semver-compare"
RELEASE_PARSER="$SCRIPT_DIR/parse-release-response.mjs"
RELEASES_API_URL="${BRICKS_SKILLS_RELEASES_API_URL:-}"

normalize_version() {
	version="$1"
	case "$version" in
		v*) version="${version#v}" ;;
	esac
	echo "$version"
}

latest_release_tag() {
	release_url="$RELEASES_API_URL"
	if [ -z "$release_url" ]; then
		case "${LOCAL%%+*}" in
			*-*) release_url="https://api.github.com/repos/codeerhq/bricks-skills/releases?per_page=20" ;;
			*) release_url="https://api.github.com/repos/codeerhq/bricks-skills/releases/latest" ;;
		esac
	fi
	response="$(curl -fsL --max-time 5 "$release_url" 2>/dev/null)" || return 1
	command -v node >/dev/null 2>&1 || return 3
	printf '%s' "$response" | node "$RELEASE_PARSER" "$LOCAL"
}

if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--force" ]; }; then
	echo "usage: bricks-skills-update-check [--force]" >&2
	exit 2
fi

if [ "$#" -eq 1 ]; then
	rm -f "$CACHE_FILE"
fi

if [ "${BRICKS_SKILLS_UPDATE_CHECK:-true}" = "false" ]; then
	exit 0
fi

if [ ! -f "$VERSION_FILE" ]; then
	exit 0
fi

LOCAL="$(sed -n '1p' "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]' || true)"
if [ -z "$LOCAL" ]; then
	exit 0
fi
if ! sh "$SEMVER_COMPARE" "$LOCAL" "$LOCAL" >/dev/null 2>&1; then
	echo "BRICKS_SKILLS_UPDATE_CHECK_FAILED $LOCAL"
	exit 0
fi

mkdir -p "$STATE_DIR"

if [ -f "$MARKER_FILE" ]; then
	OLD="$(sed -n '1p' "$MARKER_FILE" 2>/dev/null | tr -d '[:space:]' || true)"
	rm -f "$MARKER_FILE"
	if [ -n "$OLD" ]; then
		echo "BRICKS_SKILLS_JUST_UPDATED $OLD $LOCAL"
	fi
fi

if [ -f "$CACHE_FILE" ]; then
	CACHED="$(cat "$CACHE_FILE" 2>/dev/null || true)"
	case "$CACHED" in
		UP_TO_DATE*) CACHE_TTL=60 ;;
		BRICKS_SKILLS_UPDATE_AVAILABLE*) CACHE_TTL=720 ;;
		*) CACHE_TTL=0 ;;
	esac

	if [ "$CACHE_TTL" -gt 0 ] && [ -z "$(find "$CACHE_FILE" -mmin +"$CACHE_TTL" 2>/dev/null || true)" ]; then
		case "$CACHED" in
			UP_TO_DATE\ "$LOCAL"\ *) exit 0 ;;
			BRICKS_SKILLS_UPDATE_AVAILABLE\ "$LOCAL"\ *) echo "$CACHED"; exit 0 ;;
		esac
	fi
fi

if REMOTE_TAG="$(latest_release_tag)"; then
	:
else
	RELEASE_STATUS=$?
	if [ "$RELEASE_STATUS" -eq 2 ]; then
		echo "UP_TO_DATE $LOCAL none" > "$CACHE_FILE"
		exit 0
	fi
	echo "BRICKS_SKILLS_UPDATE_CHECK_FAILED $LOCAL"
	exit 0
fi
REMOTE_TAG="$(printf '%s' "$REMOTE_TAG" | tr -d '[:space:]')"

case "$REMOTE_TAG" in
	""|*[!0-9A-Za-z._+-]*)
		echo "BRICKS_SKILLS_UPDATE_CHECK_FAILED $LOCAL"
		exit 0
		;;
esac

REMOTE="$(normalize_version "$REMOTE_TAG")"

if ! ORDER="$(sh "$SEMVER_COMPARE" "$REMOTE" "$LOCAL" 2>/dev/null)"; then
	echo "BRICKS_SKILLS_UPDATE_CHECK_FAILED $LOCAL"
	exit 0
fi

if [ "$ORDER" -le 0 ]; then
	echo "UP_TO_DATE $LOCAL $REMOTE_TAG" > "$CACHE_FILE"
	exit 0
fi

echo "BRICKS_SKILLS_UPDATE_AVAILABLE $LOCAL $REMOTE $REMOTE_TAG" > "$CACHE_FILE"
echo "BRICKS_SKILLS_UPDATE_AVAILABLE $LOCAL $REMOTE $REMOTE_TAG"
