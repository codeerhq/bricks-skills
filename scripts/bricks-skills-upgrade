#!/usr/bin/env sh
# Upgrade a git checkout of the Bricks skills pack to the latest GitHub Release.

set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="${BRICKS_SKILLS_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
STATE_DIR="${BRICKS_SKILLS_STATE_DIR:-$HOME/.bricks-skills}"
VERSION_FILE="$ROOT/VERSION"
SEMVER_COMPARE="$SCRIPT_DIR/semver-compare"
RELEASE_PARSER="$SCRIPT_DIR/parse-release-response.mjs"
RELEASES_API_URL="${BRICKS_SKILLS_RELEASES_API_URL:-}"

latest_release_tag() {
	release_url="$RELEASES_API_URL"
	if [ -z "$release_url" ]; then
		case "${OLD_VERSION%%+*}" in
			*-*) release_url="https://api.github.com/repos/codeerhq/bricks-skills/releases?per_page=20" ;;
			*) release_url="https://api.github.com/repos/codeerhq/bricks-skills/releases/latest" ;;
		esac
	fi
	response="$(curl -fsL --max-time 5 "$release_url" 2>/dev/null)" || return 1
	command -v node >/dev/null 2>&1 || return 3
	printf '%s' "$response" | node "$RELEASE_PARSER" "$OLD_VERSION"
}

if ! git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	echo "BRICKS_SKILLS_NOT_GIT_INSTALL $ROOT"
	exit 2
fi

OLD_VERSION="unknown"
if [ -f "$VERSION_FILE" ]; then
	OLD_VERSION="$(sed -n '1p' "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]' || echo "unknown")"
fi

cd "$ROOT"

ALLOW_DOWNGRADE=false
if [ "${1:-}" = "--allow-downgrade" ]; then
	ALLOW_DOWNGRADE=true
	shift
fi

if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "${1#--}" != "$1" ]; }; then
	echo "usage: bricks-skills-upgrade [--allow-downgrade] [release-tag]" >&2
	exit 2
fi

TARGET_TAG="${1:-}"
if [ -z "$TARGET_TAG" ]; then
	if TARGET_TAG="$(latest_release_tag)"; then
		TARGET_TAG="$(printf '%s' "$TARGET_TAG" | tr -d '[:space:]')"
	else
		RELEASE_STATUS=$?
		if [ "$RELEASE_STATUS" -eq 2 ]; then
			echo "BRICKS_SKILLS_NO_RELEASE_FOUND"
		else
			echo "BRICKS_SKILLS_RELEASE_CHECK_FAILED"
		fi
		exit 3
	fi
fi

case "$TARGET_TAG" in
	""|*[!0-9A-Za-z._+-]*)
		echo "BRICKS_SKILLS_NO_RELEASE_FOUND"
		exit 3
		;;
esac

TARGET_VERSION="${TARGET_TAG#v}"

git fetch --tags origin

if ! REMOTE_REFS="$(git ls-remote --exit-code --tags origin "refs/tags/$TARGET_TAG" "refs/tags/$TARGET_TAG^{}" 2>/dev/null)"; then
	echo "BRICKS_SKILLS_RELEASE_TAG_NOT_FOUND $TARGET_TAG"
	exit 4
fi

REMOTE_COMMIT="$(printf '%s\n' "$REMOTE_REFS" | awk '$2 ~ /\^\{\}$/ { peeled = $1 } $2 !~ /\^\{\}$/ { direct = $1 } END { print (peeled != "" ? peeled : direct) }')"
LOCAL_TAG_COMMIT="$(git rev-parse -q --verify "refs/tags/$TARGET_TAG^{commit}" 2>/dev/null || true)"
if [ -z "$REMOTE_COMMIT" ] || [ "$LOCAL_TAG_COMMIT" != "$REMOTE_COMMIT" ]; then
	echo "BRICKS_SKILLS_RELEASE_TAG_MISMATCH $TARGET_TAG"
	exit 4
fi

TAG_VERSION="$(git show "$TARGET_TAG:VERSION" 2>/dev/null | sed -n '1p' | tr -d '[:space:]' || true)"
if [ "$TAG_VERSION" != "$TARGET_VERSION" ]; then
	echo "BRICKS_SKILLS_RELEASE_VERSION_MISMATCH $TARGET_TAG $TAG_VERSION"
	exit 4
fi

if ! ORDER="$(sh "$SEMVER_COMPARE" "$TARGET_VERSION" "$OLD_VERSION" 2>/dev/null)"; then
	echo "BRICKS_SKILLS_INVALID_RELEASE_VERSION $TARGET_TAG"
	exit 3
fi

if [ "$ORDER" -lt 0 ] && [ "$ALLOW_DOWNGRADE" != "true" ]; then
	echo "BRICKS_SKILLS_DOWNGRADE_REFUSED $OLD_VERSION $TARGET_VERSION $TARGET_TAG"
	exit 6
fi

if [ "$ORDER" -eq 0 ]; then
	CURRENT_COMMIT="$(git rev-parse HEAD)"
	CURRENT_BRANCH="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
	if [ "$CURRENT_COMMIT" = "$LOCAL_TAG_COMMIT" ] && [ -z "$CURRENT_BRANCH" ]; then
		echo "BRICKS_SKILLS_ALREADY_CURRENT $OLD_VERSION $TARGET_TAG"
		exit 0
	fi
fi

if [ -n "$(git status --porcelain)" ]; then
	if ! STASH_OUTPUT="$(git stash push -u -m "bricks-skills-upgrade-$(date +%Y%m%d%H%M%S)" 2>&1)"; then
		echo "BRICKS_SKILLS_STASH_FAILED"
		printf '%s\n' "$STASH_OUTPUT" >&2
		exit 5
	fi

	if [ -n "$(git status --porcelain)" ]; then
		echo "BRICKS_SKILLS_WORKTREE_NOT_CLEAN"
		exit 5
	fi

	echo "BRICKS_SKILLS_LOCAL_CHANGES_STASHED"
fi

git checkout --detach "$TARGET_TAG"
git reset --hard "$TARGET_TAG"

NEW_VERSION="unknown"
if [ -f "$VERSION_FILE" ]; then
	NEW_VERSION="$(sed -n '1p' "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]' || echo "unknown")"
fi

mkdir -p "$STATE_DIR"
rm -f "$STATE_DIR/last-update-check"

if [ "$ORDER" -eq 0 ]; then
	echo "BRICKS_SKILLS_PINNED $NEW_VERSION $TARGET_TAG"
	exit 0
fi

echo "$OLD_VERSION" > "$STATE_DIR/just-updated-from"
echo "BRICKS_SKILLS_UPDATED $OLD_VERSION $NEW_VERSION $TARGET_TAG"
